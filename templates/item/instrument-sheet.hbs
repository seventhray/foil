<div class="foil-sheet item instrument">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  {{> systems/foil/templates/item/partials/type-warning.hbs}}
  <div class="field-grid">
    <label>Category</label>
    <select name="system.category">{{#each categoryOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.category)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Weight class <em>(price, weight, margin cap: Light half, Medium full, Heavy doubled then full, whole turn, and two hands)</em></label>
    <select name="system.weight">{{#each weightOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.weight)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{#unless system.innate}}
    <label>Location <em>(equipped is ready in hand; switching costs the Quick Action)</em></label>
    <select name="system.location">{{#each locationOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.location)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{#if (foil-eq system.location "stored")}}
    <label>Stored at <em>(a mount, a house, a vehicle: its Mass stays there)</em></label>
    <input type="text" name="system.storedAt" value="{{system.storedAt}}" list="storage-{{item.id}}" />
    <datalist id="storage-{{item.id}}">{{#each storagePlaces}}<option value="{{this}}"></option>{{/each}}</datalist>
    {{/if}}
    {{/unless}}
    <label>Primary Attribute <em>(sets its three Skills)</em></label>
    <select name="system.primaryAttribute">{{#each attributeOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.primaryAttribute)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Max Range <em>(the farthest it reaches)</em></label>
    <select name="system.maxRange">{{#each maxBandOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.maxRange)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Min Range <em>(optional; it can't be used closer)</em></label>
    <select name="system.minRange">{{#each bandOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.minRange)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Price (p)</label>
    <input type="number" name="system.price" value="{{system.price}}" />
    <label>Bonus (+N)</label>
    <input type="number" name="system.bonus" value="{{system.bonus}}" min="0" max="5" />
    <label>Size <em>(bonus price, crafting batches)</em></label>
    <select name="system.size">{{#each sizeOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.size)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Materials</label>
    <input type="text" name="system.materials" value="{{system.materials}}" placeholder="Metal + Leather" />
    <label>Material Tier <em>(when above its +N; an Enchantment needs its own Tier, PHB 5.3.4)</em></label>
    <input type="number" name="system.tier" value="{{system.tier}}" min="0" max="5" />
    <label>Innate <em>(Body, Voice)</em></label>
    <input type="checkbox" name="system.innate" {{#if system.innate}}checked{{/if}} />
  </div>
  <fieldset>
    <legend>Instrument Types <em>(Ctrl/Cmd-click for several)</em></legend>
    <select name="system.types" multiple size="10" class="multi">
      {{#each typeOptions}}<option value="{{this.key}}" {{#if this.help}}title="{{this.help}}"{{/if}} {{#if this.checked}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
    <label class="block-label">Types as printed <em>(only when it isn't a plain list)</em></label>
    <input type="text" name="system.typesDisplay" value="{{system.typesDisplay}}" />
  </fieldset>
  <div class="derived-line">
    Formula price <strong data-var="formulaPrice">{{system.formulaPrice}}p</strong>{{#if system.priceMismatch}} <i class="fas fa-triangle-exclamation item-warning" title="Listed price differs from the PHB 5.2.2 formula"></i>{{/if}}
    {{#if system.bonus}} &middot; +{{system.bonus}} adds <strong data-var="bonusPrice">{{system.bonusPrice}}p</strong>{{/if}}
    &middot; crafts from <strong data-var="craftCost">{{system.craftCost}}p</strong> of materials
    &middot; Mass <strong data-var="carriedWeight">{{system.carriedWeight}} lbs</strong>{{#if system.weightDice}} &middot; attacks add <strong>{{system.weightDice}}</strong>{{/if}}{{#if system.twoHanded}} &middot; two hands{{/if}}{{#if system.doublesMargin}} &middot; takes the Action and the Quick Action{{/if}}{{#if (foil-eq system.marginMultiplier 2)}} &middot; margin x2{{/if}}
  </div>
  <div class="derived-line math-line"><em>Price: {{system.priceMath}} = {{system.formulaPrice}}p (PHB 5.2.2)<br>Bonus: {{system.bonusMath}}<br>Crafting: {{system.craftMath}}</em></div>
  {{#if system.bonus}}<div class="derived-line">
    {{#if system.bonusRoll}}+{{system.bonusRoll}} to rolls{{/if}}{{#if system.bonusPierce}} &middot; Pierce +{{system.bonusPierce}}{{/if}}{{#if system.bonusOppose}}+{{system.bonusOppose}} to Oppose rolls only{{/if}}
  </div>{{/if}}
  <fieldset>
    <legend>Built-in Techniques <em>(one per Skill its Primary Attribute reaches)</em></legend>
    {{#each kitRows}}
      <div class="kit-row">
        <input type="text" name="system.kit.{{this.idx}}.name" value="{{this.name}}" placeholder="Name" />
        <select name="system.kit.{{this.idx}}.skill">{{#each ../skillOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../skill)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <input type="text" name="system.kit.{{this.idx}}.effect" value="{{this.effect}}" placeholder="Deals Stress to Might or Finesse." />
        <a class="row-del" data-action="removeRow" data-path="system.kit" data-index="{{this.idx}}"><i class="fas fa-trash"></i></a>
      </div>
    {{/each}}
    <a class="inline-add" data-action="addRow" data-path="system.kit"><i class="fas fa-plus"></i> Add</a>
    <label class="block-label">Note</label>
    <input type="text" name="system.rider" value="{{system.rider}}" />
  </fieldset>
  <fieldset>
    <legend>Enchantment <em>(PHB 5.3.4)</em></legend>
    <label><input type="checkbox" name="system.enchantment.enabled" {{#if system.enchantment.enabled}}checked{{/if}} /> Enchanted</label>
    <div class="field-grid">
      <label>Or a bonus <em>(one Enchantment per item)</em></label>
      <select name="system.enchantment.bonus.kind">{{#each enchantKindOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.enchantment.bonus.kind)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      {{#if system.enchantment.bonus.kind}}
        <label>Skill <em>(for a Skill bonus)</em></label>
        <select name="system.enchantment.bonus.skill"><option value="">None</option>{{#each skillOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.enchantment.bonus.skill)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <label>N <em>(+1 to +5)</em></label>
        <input type="number" name="system.enchantment.bonus.n" value="{{system.enchantment.bonus.n}}" min="1" max="5" />
      {{/if}}
    </div>
    {{#if system.enchantBonus}}<div class="derived-line"><strong>{{system.enchantBonus.label}}</strong> &middot; {{system.enchantBonus.price}}p &middot; Tier {{system.enchantBonus.materialTier}} materials &middot; Craft against {{system.enchantBonus.difficulty}} &middot; {{system.enchantBonus.hours}} h, {{system.enchantBonus.workStrain}} Strain to each of the enchanter's Attributes</div>
      {{#if system.enchantment.enabled}}<p class="type-warning-banner">An item holds one Enchantment: a Technique or a bonus, not both (PHB 5.3.4).</p>{{/if}}{{/if}}
    {{#if system.enchantment.enabled}}
      <div class="effect-row-list">{{> systems/foil/templates/item/partials/effect-rows.hbs rows=enchantEffectRows path="system.enchantment.effects"}}</div>
      <label class="block-label">Effect as printed</label>
      <input type="text" name="system.enchantment.effectText" value="{{system.enchantment.effectText}}" />
      <div class="derived-line"><strong>{{system.enchantment.xpCost}} XP</strong> &middot; Strain {{system.enchantment.strain}} &middot; {{system.enchantment.price}}p &middot; Tier {{system.enchantment.materialTier}} materials &middot; Craft against {{system.enchantment.difficulty}} &middot; {{system.enchantment.hours}} h, {{system.enchantment.workStrain}} Strain to each of the enchanter's Attributes</div>
    {{/if}}
  </fieldset>
  {{> systems/foil/templates/item/partials/item-description.hbs rows=3}}
</div>
