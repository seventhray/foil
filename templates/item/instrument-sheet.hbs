<div class="foil-sheet item instrument">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  {{> systems/foil/templates/item/partials/type-warning.hbs}}
  <div class="field-grid">
    <label>Category</label>
    <select name="system.category">{{#each categoryOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.category)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Weight class <em>(price, weight, attack dice: Medium +1d6, Heavy +2d4 and two hands)</em></label>
    <select name="system.weight">{{#each weightOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.weight)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{#unless system.innate}}
    <label>Location <em>(equipped is ready in hand; switching costs the Quick Action)</em></label>
    <select name="system.location">{{#each locationOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.location)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{/unless}}
    <label>Primary Attribute <em>(sets its three Skills)</em></label>
    <select name="system.primaryAttribute">{{#each attributeOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.primaryAttribute)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Range</label>
    <input type="text" name="system.range" value="{{system.range}}" placeholder="Close, Near, Short Range..." />
    <label>Price (p)</label>
    <input type="number" name="system.price" value="{{system.price}}" />
    <label>Bonus (+N)</label>
    <input type="number" name="system.bonus" value="{{system.bonus}}" min="0" max="5" />
    <label>Size <em>(bonus price, crafting batches)</em></label>
    <select name="system.size">{{#each sizeOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.size)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Materials</label>
    <input type="text" name="system.materials" value="{{system.materials}}" placeholder="Metal + Leather" />
    <label>Innate <em>(Body, Voice)</em></label>
    <input type="checkbox" name="system.innate" {{#if system.innate}}checked{{/if}} />
  </div>
  <fieldset>
    <legend>Instrument Types <em>(Ctrl/Cmd-click for several)</em></legend>
    <select name="system.types" multiple size="10" class="multi">
      {{#each typeOptions}}<option value="{{this.key}}" {{#if this.checked}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
    <label class="block-label">Types as printed <em>(only when it isn't a plain list)</em></label>
    <input type="text" name="system.typesDisplay" value="{{system.typesDisplay}}" />
  </fieldset>
  <div class="derived-line">
    Formula price <strong>{{system.formulaPrice}}p</strong>{{#if system.priceMismatch}} <i class="fas fa-triangle-exclamation item-warning" title="Listed price differs from the PHB 5.2.2 formula"></i>{{/if}}
    {{#if system.bonus}} &middot; +{{system.bonus}} adds <strong>{{system.bonusPrice}}p</strong>{{/if}}
    &middot; crafts from <strong>{{system.craftCost}}p</strong> of materials
    &middot; carries <strong>{{system.carriedWeight}} lbs</strong>{{#if system.weightDice}} &middot; attacks add <strong>{{system.weightDice}}</strong>{{/if}}{{#if system.twoHanded}} &middot; two hands{{/if}}{{#if system.doublesMargin}} &middot; takes the Action and the Quick Action, margin doubled{{/if}}
  </div>
  {{#if system.bonus}}<div class="derived-line">
    {{#if system.bonusRoll}}+{{system.bonusRoll}} to rolls{{/if}}{{#if system.bonusPierce}} &middot; Pierce +{{system.bonusPierce}}{{/if}}{{#if system.bonusOppose}}+{{system.bonusOppose}} to Oppose rolls only{{/if}}
  </div>{{/if}}
  <fieldset>
    <legend>Built-in Techniques <em>(one per Skill its Primary Attribute reaches)</em></legend>
    {{#each kitRows}}
      <div class="kit-row">
        <input type="text" name="system.kit.{{this.idx}}.name" value="{{this.name}}" placeholder="Name" />
        <select name="system.kit.{{this.idx}}.skill">{{#each ../skillOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../skill)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <input type="text" name="system.kit.{{this.idx}}.effect" value="{{this.effect}}" placeholder="Deals Stress to Might or Finesse." />
        <a class="row-del" data-action="removeRow" data-path="system.kit" data-index="{{this.idx}}"><i class="fas fa-trash"></i></a>
      </div>
    {{/each}}
    <a class="inline-add" data-action="addRow" data-path="system.kit"><i class="fas fa-plus"></i> Add</a>
    <label class="block-label">Note</label>
    <input type="text" name="system.rider" value="{{system.rider}}" />
  </fieldset>
  <fieldset>
    <legend>Focus Gem <em>(Arcane Instruments only, PHB 5.2.3)</em></legend>
    <div class="field-grid">
      <label>Gem</label>
      <select name="system.gem.type">{{#each gemOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.gem.type)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      <label>Tier</label>
      <input type="number" name="system.gem.tier" value="{{system.gem.tier}}" min="1" max="5" />
    </div>
    {{#if system.gemSummary}}<div class="derived-line">{{system.gemSummary}}</div>{{/if}}
    {{#if system.gemWarning}}<p class="type-warning-banner">{{system.gemWarning}}</p>{{/if}}
  </fieldset>
  <fieldset>
    <legend>Enchantment <em>(GMG 8.2.0)</em></legend>
    <label><input type="checkbox" name="system.enchantment.enabled" {{#if system.enchantment.enabled}}checked{{/if}} /> Enchanted</label>
    {{#if system.enchantment.enabled}}
      <div class="effect-row-list">{{> systems/foil/templates/item/partials/effect-rows.hbs rows=enchantEffectRows path="system.enchantment.effects"}}</div>
      <label class="block-label">Effect as printed</label>
      <input type="text" name="system.enchantment.effectText" value="{{system.enchantment.effectText}}" />
      <div class="derived-line"><strong>{{system.enchantment.xpCost}} XP</strong> &middot; Strain {{system.enchantment.strain}} &middot; {{system.enchantment.price}}p &middot; crafted at Difficulty {{system.enchantment.difficulty}} from Tier {{system.enchantment.materialTier}} Gemstone</div>
    {{/if}}
  </fieldset>
  {{> systems/foil/templates/item/partials/item-description.hbs rows=3}}
</div>
