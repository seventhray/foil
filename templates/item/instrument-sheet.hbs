<div class="foil-sheet item instrument">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  {{> systems/foil/templates/item/partials/type-warning.hbs}}

  <div class="field-grid">
    <label>Weight</label>
    <select name="system.weight">
      {{#each weights}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.weight)}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>

    <label>Range</label>
    <select name="system.range">
      {{#each ranges}}<option value="{{this}}" {{#if (foil-eq this ../system.range)}}selected{{/if}}>{{this}}</option>{{/each}}
    </select>

    <label>Price (pennies)</label>
    <input type="number" name="system.price" value="{{system.price}}" />

    <label>Bonus (+N)</label>
    <input type="number" name="system.bonus" value="{{system.bonus}}" min="0" max="5" />

    <label>Reload <em>(PHB §7.11.1 — 1 AP to reload before the next attack)</em></label>
    <input type="checkbox" name="system.reload" {{#if system.reload}}checked{{/if}} />
  </div>

  <fieldset>
    <legend>Instrument Types <em>(Ctrl/Cmd-click to select several)</em></legend>
    <select name="system.types" multiple size="12" class="multi">
      {{#each typeOptions}}<option value="{{this.key}}" {{#if this.checked}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
  </fieldset>

  <div class="derived-line">Stress <strong>{{system.weightMult}}</strong> the margin · base AP <strong>{{system.baseAP}}</strong></div>
  {{#if system.bonusByType.length}}
  <div class="derived-line hint">
    {{#each system.bonusByType}}
      <strong>{{this.label}}</strong>: +{{this.bonusStress}} Stress on a landed hit{{#unless @last}} · {{/unless}}
    {{/each}}
    {{#if system.reload}} · <strong>Reload</strong>{{/if}}
  </div>
  {{/if}}
  {{#if system.bonus}}
  <div class="derived-line">
    {{#if system.bonusAccuracy}}Accuracy +{{system.bonusAccuracy}}{{/if}}
    {{#if system.bonusPierce}} · Pierce +{{system.bonusPierce}}{{/if}}
    {{#if system.bonusBolsterProwess}}Bolster +{{system.bonusBolsterProwess}} Prowess · Resistance +{{system.bonusResistance}} (to what it protects){{/if}}
  </div>
  {{/if}}

  <fieldset>
    <legend>Material <em>(PHB §7.4.2 — fiction-only name, Tier/Scarcity are the mechanics)</em></legend>
    <div class="field-grid">
      <label>Category</label>
      <select name="system.materialCategory">
        {{#each materialCategories}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.materialCategory)}}selected{{/if}}>{{this.label}}</option>{{/each}}
      </select>
      <label>Tier</label>
      <input type="number" name="system.materialTier" value="{{system.materialTier}}" min="0" max="5" />
      <label>Scarcity</label>
      <select name="system.materialScarcity">
        {{#each materialScarcities}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.materialScarcity)}}selected{{/if}}>{{this.label}}</option>{{/each}}
      </select>
    </div>
    {{#if system.materialCategory}}<div class="derived-line">Standard price if bought: <strong>{{system.materialPrice}}p</strong></div>{{/if}}
  </fieldset>

  <fieldset>
    <legend>Enchantment <em>(PHB §5.4.2 — a Technique effect bound to this item, usable by anyone)</em></legend>
    <label><input type="checkbox" name="system.enchantment.enabled" {{#if system.enchantment.enabled}}checked{{/if}} /> Enchanted</label>
    {{#if system.enchantment.enabled}}
      <div class="effect-row-list">
        {{#each enchantEffectRows}}
          <div class="effect-row">
            <select class="ef-key" name="system.enchantment.effects.{{this.idx}}.key" title="Which Effect this row applies (GMG §5.1.0 pricing catalog)">
              <option value="" {{#unless this.key}}selected{{/unless}}>—</option>
              {{#each ../effectOptions}}<option value="{{this.key}}" {{#if (foil-eq this.key ../key)}}selected{{/if}}>{{this.label}}</option>{{/each}}
            </select>
            <div class="ef-field">
              <label class="mini-label" title="Magnitude — the effect's point value (e.g. Stress dealt, Impair amount). Multiplies its per-point XP cost.">Mag</label>
              <input type="number" class="mini-num" name="system.enchantment.effects.{{this.idx}}.magnitude" value="{{this.magnitude}}" title="Magnitude (point value)" />
            </div>
            <div class="ef-field">
              <label class="mini-label" title="Area shape. Only priced if this row's Effect is an area/Pattern effect — leave Single otherwise.">Shape</label>
              <select name="system.enchantment.effects.{{this.idx}}.pattern" title="Area shape (Single = no area)">
                {{#each ../patternShapes}}<option value="{{this.value}}" {{#if (foil-eq this.value ../pattern)}}selected{{/if}}>{{this.label}}</option>{{/each}}
              </select>
            </div>
            <div class="ef-field">
              <label class="mini-label" title="Bands — the area's reach for a Pattern effect, or the extra range bands bought for an Extend Range effect.">Bands</label>
              <input type="number" class="mini-num" name="system.enchantment.effects.{{this.idx}}.bands" value="{{this.bands}}" title="Bands (Pattern reach / Extend Range)" />
            </div>
            <div class="ef-field">
              <label class="mini-label" title="Placement — how many bands the Pattern's origin point can be set away from the caster. Adds to the Pattern's XP cost.">Place</label>
              <input type="number" class="mini-num" name="system.enchantment.effects.{{this.idx}}.placement" value="{{this.placement}}" title="Placement bands (Pattern only)" />
            </div>
            <div class="ef-field">
              <label class="mini-label" title="Selective N — how many separate targets this effect can strike (instead of one). Priced as N + R×N.">Sel N</label>
              <input type="number" class="mini-num" name="system.enchantment.effects.{{this.idx}}.selectiveN" value="{{this.selectiveN}}" title="Selective: number of targets" />
            </div>
            <div class="ef-field">
              <label class="mini-label" title="Selective R — how many range bands apart those Selective targets may be.">Sel R</label>
              <input type="number" class="mini-num" name="system.enchantment.effects.{{this.idx}}.selectiveR" value="{{this.selectiveR}}" title="Selective: range bands between targets" />
            </div>
            <a class="row-del" data-action="removeEnchantEffect" data-index="{{this.idx}}" title="Remove"><i class="fas fa-trash"></i></a>
          </div>
        {{/each}}
        <a class="inline-add" data-action="addEnchantEffect" title="Add effect"><i class="fas fa-plus"></i> Add effect</a>
      </div>
      <label class="block-label">Effect Text <em>(flavor / summary; optional)</em></label>
      <textarea name="system.enchantment.effectText" rows="2">{{system.enchantment.effectText}}</textarea>
      <div class="field-grid">
        <label>Floor Override</label>
        <input type="number" name="system.enchantment.floorOverride" value="{{system.enchantment.floorOverride}}" title="Minimum XP for ward / answers-a-class effects" />
      </div>
      <div class="derived-line">
        <strong>{{system.enchantment.xpCost}} XP</strong> · Strain <strong>{{system.enchantment.strain}}</strong> ·
        Price <strong>{{system.enchantment.price}}p</strong> ·
        Aptitude rolled: <strong>{{foil-capitalize system.enchantment.aptitudeDisplay}}</strong>
      </div>
      {{#if system.enchantment.difficulty}}
      <div class="derived-line hint">
        To craft: Difficulty <strong>{{system.enchantment.difficulty}}</strong> · two batches of Gemstone at Tier <strong>{{system.enchantment.craftMaterialTier}}</strong> (GMG §8.2.0)
      </div>
      {{/if}}
    {{/if}}
  </fieldset>

  {{> systems/foil/templates/item/partials/item-description.hbs rows=4}}
</div>
