<div class="foil-sheet item equipment">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  <div class="field-grid">
    <label>Category</label>
    <select name="system.category">{{#each equipmentCategoryOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.category)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Price (p)</label>
    <input type="number" name="system.price" value="{{system.price}}" />
    <label>Mass (lbs) <em>(PHB 5.2.6)</em></label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.5" />
    {{#if (foil-eq system.category "shield")}}
      <label>Weight class</label>
      <select name="system.weightClass">{{#each weightClassOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.weightClass)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{/if}}
    <label>Size</label>
    <select name="system.size">{{#each sizeOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.size)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Materials</label>
    <input type="text" name="system.materials" value="{{system.materials}}" />
    <label>Location <em>(only equipped gear grants its Resistance or bonus)</em></label>
    <select name="system.location">{{#each locationOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.location)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{#if (foil-eq system.location "stored")}}
    <label>Stored at <em>(a mount, a house, a vehicle: its Mass stays there)</em></label>
    <input type="text" name="system.storedAt" value="{{system.storedAt}}" list="storage-{{item.id}}" />
    <datalist id="storage-{{item.id}}">{{#each storagePlaces}}<option value="{{this}}"></option>{{/each}}</datalist>
    {{/if}}
    <label>Uses</label>
    <input type="text" name="system.uses" value="{{system.uses}}" />
    <label>Duration</label>
    <input type="text" name="system.duration" value="{{system.duration}}" />
  </div>
  <fieldset>
    <legend>Properties <em>(PHB 7.9.1)</em></legend>
    {{#each qualityRows}}
      <div class="quality-row">
        <select name="system.qualities.{{this.idx}}.key">
          <option value="" {{#unless this.key}}selected{{/unless}}>&mdash;</option>
          {{#each ../qualityOptions}}<option value="{{this.key}}" {{#if (foil-eq this.key ../key)}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
        <input type="number" class="mini-num" name="system.qualities.{{this.idx}}.value" value="{{this.value}}" />
        {{#if this.choices}}
          <select name="system.qualities.{{this.idx}}.param">{{#each this.choices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        {{else}}
          <input type="text" name="system.qualities.{{this.idx}}.param" value="{{this.param}}" placeholder="task" />
        {{/if}}
        <a class="row-del" data-action="removeRow" data-path="system.qualities" data-index="{{this.idx}}"><i class="fas fa-trash"></i></a>
      </div>
    {{/each}}
    <a class="inline-add" data-action="addRow" data-path="system.qualities"><i class="fas fa-plus"></i> Add</a>
  </fieldset>
  <fieldset>
    <legend>Enchantment <em>(PHB 5.3.4)</em></legend>
    <div class="field-grid">
      <label>Bonus</label>
      <select name="system.enchantment.bonus.kind">{{#each equipEnchantOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.enchantment.bonus.kind)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      {{#if system.enchantment.bonus.kind}}
        <label>Of</label>
        <select name="system.enchantment.bonus.param">{{#each equipEnchantParams}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.enchantment.bonus.param)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <label>N <em>(+1 to +5)</em></label>
        <input type="number" name="system.enchantment.bonus.n" value="{{system.enchantment.bonus.n}}" min="1" max="5" />
      {{/if}}
    </div>
    <label><input type="checkbox" name="system.enchantment.enabled" {{#if system.enchantment.enabled}}checked{{/if}} /> Or a Technique that takes no roll</label>
    {{#if system.enchantment.enabled}}
      <div class="effect-row-list">{{> systems/foil/templates/item/partials/effect-rows.hbs rows=enchantEffectRows path="system.enchantment.effects"}}</div>
      <label class="block-label">Effect as printed</label>
      <input type="text" name="system.enchantment.effectText" value="{{system.enchantment.effectText}}" />
      <div class="derived-line"><strong>{{system.enchantment.xpCost}} XP</strong> &middot; {{system.enchantment.effectSummary}} &middot; {{system.enchantment.price}}p &middot; Tier {{system.enchantment.materialTier}} materials &middot; Craft against {{system.enchantment.difficulty}} &middot; {{system.enchantment.hours}} h, {{system.enchantment.workStrain}} Strain to each of the enchanter's Attributes</div>
    {{/if}}
    {{#if system.enchantBonus}}<div class="derived-line"><strong>{{system.enchantBonus.label}}</strong> &middot; {{system.enchantBonus.price}}p &middot; Tier {{system.enchantBonus.materialTier}} materials &middot; Craft against {{system.enchantBonus.difficulty}} &middot; {{system.enchantBonus.hours}} h, {{system.enchantBonus.workStrain}} Strain to each of the enchanter's Attributes</div>{{/if}}
  </fieldset>
  <label class="block-label">Effect</label>
  <input type="text" name="system.effect" value="{{system.effect}}" />
  <label class="block-label">Notes</label>
  <input type="text" name="system.notes" value="{{system.notes}}" />
  {{> systems/foil/templates/item/partials/item-description.hbs rows=3}}
</div>
