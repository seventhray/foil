<div class="foil-sheet item definition">
  {{> systems/foil/templates/item/partials/item-head.hbs titlePlaceholder="Effect"}}
  <div class="field-grid">
    <label>Key (slug)</label>
    <input type="text" name="system.key" value="{{system.key}}" />
    <label>Priced as</label>
    <select name="system.pricingKind">{{#each pricingKinds}}<option value="{{this.value}}" title="{{this.hint}}" {{#if (foil-eq this.value ../system.pricingKind)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Base XP</label>
    <input type="number" name="system.pricingParams.base" value="{{system.pricingParams.base}}" />
    <label>XP per point</label>
    <input type="number" name="system.pricingParams.perPoint" value="{{system.pricingParams.perPoint}}" />
    <label>XP per band</label>
    <input type="number" name="system.pricingParams.perBand" value="{{system.pricingParams.perBand}}" />
    <label>Reads as <em>(N for the magnitude)</em></label>
    <input type="text" name="system.magnitudeLabel" value="{{system.magnitudeLabel}}" placeholder="Pierce N" />
    <label>Doesn't count toward the +4 premium</label>
    <input type="checkbox" name="system.exemptFromPremium" {{#if system.exemptFromPremium}}checked{{/if}} />
    <label>Sets the 8 XP floor</label>
    <input type="checkbox" name="system.setsFloor" {{#if system.setsFloor}}checked{{/if}} />
  </div>
  <fieldset>
    <legend>Instrument Types that can deliver it <em>(none = any)</em></legend>
    <select name="system.requires" multiple size="8" class="multi">
      {{#each typeOptions}}<option value="{{this.key}}" {{#if this.checked}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
  </fieldset>
  {{> systems/foil/templates/item/partials/item-description.hbs rows=4}}
</div>
