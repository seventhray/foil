<div class="foil-sheet item definition">
  {{> systems/foil/templates/item/partials/item-head.hbs titlePlaceholder="Property"}}
  <div class="field-grid">
    <label>Key (slug)</label>
    <input type="text" name="system.key" value="{{system.key}}" />
    <label>Kind</label>
    <select name="system.kind">{{#each qualityKinds}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.kind)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Its parameter names</label>
    <select name="system.scope">{{#each qualityScopes}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.scope)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Value label</label>
    <input type="text" name="system.valueLabel" value="{{system.valueLabel}}" />
  </div>
  {{> systems/foil/templates/item/partials/item-description.hbs rows=4}}
</div>
