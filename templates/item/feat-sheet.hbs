<div class="foil-sheet item feat">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  <div class="field-grid">
    <label>Kind</label>
    <select name="system.featType">{{#each featTypeOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.featType)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>XP</label>
    <input type="number" name="system.xpCost" value="{{system.xpCost}}" />
    <label>Requires</label>
    <input type="text" name="system.requirements" value="{{system.requirements}}" />
    <label>Origin</label>
    <select name="system.ancestry">{{#each originOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.ancestry)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Grants Technique</label>
    <select name="system.grantsTechnique">{{#each techniqueNameOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.grantsTechnique)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
  </div>
  <label class="block-label">Effect</label>
  <textarea name="system.effect" rows="3">{{system.effect}}</textarea>
  <fieldset>
    <legend>Flat modifiers <em>(Training or Resistance it grants)</em></legend>
    {{#each modifierRows}}
      <div class="quality-row">
        <select name="system.modifiers.{{this.idx}}.type">{{#each ../modifierTypeOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../type)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <select name="system.modifiers.{{this.idx}}.key">{{#each ../modifierKeyGroups}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}" {{#if (foil-eq this.value ../../key)}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}</select>
        <input type="number" class="mini-num" name="system.modifiers.{{this.idx}}.value" value="{{this.value}}" />
        <a class="row-del" data-action="removeRow" data-path="system.modifiers" data-index="{{this.idx}}"><i class="fas fa-trash"></i></a>
      </div>
    {{/each}}
    <a class="inline-add" data-action="addRow" data-path="system.modifiers"><i class="fas fa-plus"></i> Add</a>
  </fieldset>
  {{> systems/foil/templates/item/partials/item-description.hbs rows=3}}
</div>
