<div class="foil-sheet item definition">
  {{> systems/foil/templates/item/partials/item-head.hbs titlePlaceholder="Instrument Type"}}
  <div class="field-grid">
    <label>Key (slug)</label>
    <input type="text" name="system.key" value="{{system.key}}" />
    <label>Family</label>
    <select name="system.family">{{#each familyOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.family)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Stress vs physical</label>
    <input type="number" name="system.stressPhysical" value="{{system.stressPhysical}}" />
    <label>Stress vs mental</label>
    <input type="number" name="system.stressMental" value="{{system.stressMental}}" />
    <label>Pierce vs physical Resistance</label>
    <input type="number" name="system.pierce" value="{{system.pierce}}" />
    <label>No bonus vs any Resistance <em>(Edged)</em></label>
    <input type="checkbox" name="system.noBonusVsResistance" {{#if system.noBonusVsResistance}}checked{{/if}} />
    <label>Deals no Stress <em>(Grappling)</em></label>
    <input type="checkbox" name="system.dealsNoStress" {{#if system.dealsNoStress}}checked{{/if}} />
    <label>Quick <em>(built-ins as a Quick Action)</em></label>
    <input type="checkbox" name="system.quick" {{#if system.quick}}checked{{/if}} />
    <label>Blocking <em>(+N to Oppose only)</em></label>
    <input type="checkbox" name="system.blocking" {{#if system.blocking}}checked{{/if}} />
    <label>Reload</label>
    <select name="system.reload">{{#each reloadOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.reload)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Tool or Craft <em>(a Trade)</em></label>
    <input type="checkbox" name="system.isTool" {{#if system.isTool}}checked{{/if}} />
  </div>
  {{> systems/foil/templates/item/partials/item-description.hbs rows=4}}
</div>
