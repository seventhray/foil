<div class="foil-sheet item material">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  <div class="field-grid">
    <label>Category <em>(PHB 5.3.1)</em></label>
    <select name="system.category">{{#each materialCategoryOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.category)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Tier</label>
    <input type="number" name="system.tier" value="{{system.tier}}" min="0" max="5" />
    <label>Scarcity</label>
    <select name="system.scarcity">{{#each scarcityOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.scarcity)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Batches</label>
    <input type="number" name="system.batches" value="{{system.batches}}" min="0" step="0.25" />
    <label>Mass a batch (lbs) <em>(0 takes the category's: {{system.lbsEach}} lbs; PHB 5.2.6)</em></label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.5" />
    <label>Location</label>
    <select name="system.location">{{#each consumableLocationOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.location)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{#if (foil-eq system.location "stored")}}
    <label>Stored at <em>(a mount, a house, a vehicle: its Mass stays there)</em></label>
    <input type="text" name="system.storedAt" value="{{system.storedAt}}" list="storage-{{item.id}}" />
    <datalist id="storage-{{item.id}}">{{#each storagePlaces}}<option value="{{this}}"></option>{{/each}}</datalist>
    {{/if}}
  </div>
  <div class="derived-line">
    <strong>{{system.price}}p</strong> a batch &middot; <strong>{{system.lbsEach}} lbs</strong> a batch
    &middot; Mass <strong data-var="carriedWeight">{{system.carriedWeight}} lbs</strong>
  </div>
  <div class="derived-line math-line"><em>Price: Tier {{system.tier}} at {{system.scarcityLabel}} (PHB 5.3.1). Mass: {{system.batches}} batches x {{system.lbsEach}} lbs (PHB 5.2.6)</em></div>
  <label class="block-label">Notes</label>
  <input type="text" name="system.notes" value="{{system.notes}}" />
  {{> systems/foil/templates/item/partials/item-description.hbs rows=3}}
</div>
