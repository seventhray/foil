<div class="foil-sheet item technique">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  {{> systems/foil/templates/item/partials/type-warning.hbs}}
  <div class="derived-line price-readout">
    <strong>{{system.xpCost}} XP</strong> &middot; Strain <strong>{{system.strain}}</strong>
    <em>(computed from the Effects below)</em>
  </div>
  <div class="field-grid">
    <label>Requires, as printed</label>
    <input type="text" name="system.requiresText" value="{{system.requiresText}}" placeholder="Edged or Pointed" />
    <label>Innate <em>(no Instrument)</em></label>
    <input type="checkbox" name="system.innate" {{#if system.innate}}checked{{/if}} />
    <label>Skill <em>(if it names one)</em></label>
    <select name="system.skill">{{#each skillOrNoneOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.skill)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Defensive floor <em>(ward, answers a class, 8 XP)</em></label>
    <input type="checkbox" name="system.floor" {{#if system.floor}}checked{{/if}} />
    <label>Family / group</label>
    <span><input type="text" name="system.family" value="{{system.family}}" /> <input type="text" name="system.subgroup" value="{{system.subgroup}}" /></span>
    <label>Origin grant</label>
    <input type="text" name="system.ancestryGrant" value="{{system.ancestryGrant}}" />
  </div>
  <fieldset>
    <legend>Requires Instrument Type <em>(any one of)</em></legend>
    <select name="system.requires" multiple size="10" class="multi">
      {{#each typeOptions}}<option value="{{this.key}}" {{#if this.checked}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
  </fieldset>
  <fieldset>
    <legend>Effects <em>(price, GMG 12.1.0)</em></legend>
    <div class="effect-row-list">{{> systems/foil/templates/item/partials/effect-rows.hbs rows=effectRows path="system.effects"}}</div>
  </fieldset>
  <label class="block-label">Effect as printed</label>
  <input type="text" name="system.effectText" value="{{system.effectText}}" />
  {{> systems/foil/templates/item/partials/item-description.hbs rows=3}}
</div>
