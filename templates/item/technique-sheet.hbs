<div class="foil-sheet item technique">
  {{> systems/foil/templates/item/partials/item-head.hbs}}
  {{> systems/foil/templates/item/partials/type-warning.hbs}}
  <div class="derived-line price-readout">
    <strong>{{system.xpCost}} XP</strong> &middot; Strain <strong>{{system.strain}}</strong>
    <em>(computed from the Effects below)</em>
  </div>
  <div class="field-grid">
    <label>Innate <em>(no Instrument)</em></label>
    <input type="checkbox" name="system.innate" {{#if system.innate}}checked{{/if}} />
    <label>Skill <em>(if it names one)</em></label>
    <select name="system.skill">{{#each skillOrNoneOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.skill)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Defensive floor <em>(a ward or answer to a class of attack; sets a minimum price of 8 XP)</em></label>
    <input type="checkbox" name="system.floor" {{#if system.floor}}checked{{/if}} />
    <label>Catalog family <em>(only sorts it into a compendium folder, such as Melee or Kinetic)</em></label>
    <select name="system.family">{{#each familyChoices}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.family)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    <label>Catalog group <em>(subfolder inside the family, such as Control or Piercing)</em></label>
    <select name="system.subgroup">{{#each subgroupGroups}}{{#if this.label}}<optgroup label="{{this.label}}">{{/if}}{{#each this.options}}<option value="{{this.value}}" {{#if (foil-eq this.value ../../system.subgroup)}}selected{{/if}}>{{this.label}}</option>{{/each}}{{#if this.label}}</optgroup>{{/if}}{{/each}}</select>
    <label>Free from Origin <em>(an Origin Feat teaches it at no cost; a label only)</em></label>
    <select name="system.ancestryGrant">{{#each originOptions}}<option value="{{this.value}}" {{#if (foil-eq this.value ../system.ancestryGrant)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
  </div>
  <fieldset>
    <legend>Requires Instrument Type <em>(any one of)</em></legend>
    <select name="system.requires" multiple size="10" class="multi">
      {{#each typeOptions}}<option value="{{this.key}}" {{#if this.help}}title="{{this.help}}"{{/if}} {{#if this.checked}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
  </fieldset>
  <fieldset>
    <legend>Effects <em>(price, GMG 12.1.0)</em></legend>
    <div class="effect-row-list">{{> systems/foil/templates/item/partials/effect-rows.hbs rows=effectRows path="system.effects"}}</div>
  </fieldset>
  {{> systems/foil/templates/item/partials/item-description.hbs rows=3}}
</div>
