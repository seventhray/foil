{{!-- Composed Effect rows for pricing. `rows` are the entries, `path` the array's system path. --}}
{{#each rows}}
  <div class="effect-row">
    <select class="ef-key" name="{{../path}}.{{this.idx}}.key" title="{{#if this.help}}{{this.help}}{{else}}Which Effect (Fundamental Math, Effects table){{/if}}">
      <option value="" {{#unless this.key}}selected{{/unless}}>&mdash;</option>
      {{#each ../effectOptions}}<option value="{{this.key}}" {{#if (foil-eq this.key ../key)}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
    {{#if this.hasDuration}}<div class="ef-field"><label class="mini-label" title="How long the effect lasts">Lasts</label>
      <select name="{{../path}}.{{this.idx}}.lasts"><option value="round" {{#unless this.minute}}selected{{/unless}}>1 round</option><option value="minute" {{#if this.minute}}selected{{/if}}>1 minute</option></select></div>{{/if}}
    {{#if this.durationChoices}}<div class="ef-field"><label class="mini-label" title="How long the Condition lasts. It doesn't change the price.">Lasts</label>
      <select name="{{../path}}.{{this.idx}}.duration">{{#each this.durationChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></div>{{/if}}
    {{#if this.showN}}<div class="ef-field"><label class="mini-label" title="N, for an Effect priced per point">N</label>
      <input type="number" class="mini-num" name="{{../path}}.{{this.idx}}.magnitude" value="{{this.magnitude}}" /></div>{{/if}}
    {{#if this.showPattern}}<div class="ef-field wide"><label class="mini-label" title="Pattern shape">Shape</label>
      <select name="{{../path}}.{{this.idx}}.pattern">{{#each ../patternShapes}}<option value="{{this.value}}" {{#if (foil-eq this.value ../pattern)}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></div>{{/if}}
    {{#if this.showBands}}<div class="ef-field"><label class="mini-label" title="Bands of reach (Close 1, Near 2, Short 3, Mid 4, Long 5)">Reach</label>
      <input type="number" class="mini-num" name="{{../path}}.{{this.idx}}.bands" value="{{this.bands}}" /></div>{{/if}}
    {{#if this.showPattern}}<div class="ef-field"><label class="mini-label" title="Placement R: a Radius or Wall set up to R bands away">Place</label>
      <input type="number" class="mini-num" name="{{../path}}.{{this.idx}}.placement" value="{{this.placement}}" /></div>{{/if}}
    {{#if this.showSelective}}<div class="ef-field"><label class="mini-label" title="Selective: chooses creatures within this many bands">Within</label>
      <input type="number" class="mini-num" name="{{../path}}.{{this.idx}}.selectiveR" value="{{this.selectiveR}}" /></div>{{/if}}
    <span class="ef-readout" {{#if this.help}}data-tooltip="{{this.help}}"{{/if}}>{{this.label}}</span>
    <a class="row-del" data-action="removeRow" data-path="{{../path}}" data-index="{{this.idx}}" title="Remove"><i class="fas fa-trash"></i></a>
  </div>
{{/each}}
<a class="inline-add" data-action="addRow" data-path="{{path}}"><i class="fas fa-plus"></i> Add Effect</a>
