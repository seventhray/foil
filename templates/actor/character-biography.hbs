<div class="foil-part-biography">
  <section class="prompts">
    <h3 class="section-head">Who They Are</h3>
    <label>Where from, and what pulled them into conflict?</label>
    <textarea name="system.prompts.whoTheyAre" rows="2">{{system.prompts.whoTheyAre}}</textarea>
    <label>What do they want most?</label>
    <textarea name="system.prompts.wants" rows="2">{{system.prompts.wants}}</textarea>
    <label>Who or what do they fight for?</label>
    <textarea name="system.prompts.fightFor" rows="2">{{system.prompts.fightFor}}</textarea>
    <label>What is one thing they fear or avoid?</label>
    <textarea name="system.prompts.fears" rows="2">{{system.prompts.fears}}</textarea>
  </section>
  <section class="appearance">
    <h3 class="section-head">Appearance</h3>
    <div class="look-grid">
      <label>Age</label><input type="text" name="system.appearance.age" value="{{system.appearance.age}}" />
      <label>Height</label><input type="text" name="system.appearance.height" value="{{system.appearance.height}}" />
      <label>Weight</label><input type="text" name="system.appearance.weight" value="{{system.appearance.weight}}" />
      <label>Hair</label><input type="text" name="system.appearance.hair" value="{{system.appearance.hair}}" />
      <label>Eyes</label><input type="text" name="system.appearance.eyes" value="{{system.appearance.eyes}}" />
      <label>Skin</label><input type="text" name="system.appearance.skin" value="{{system.appearance.skin}}" />
    </div>
    <label>Build and distinguishing marks</label>
    <textarea name="system.appearance.marks" rows="2">{{system.appearance.marks}}</textarea>
    <label>Clothing and other details</label>
    <textarea name="system.appearance.other" rows="2">{{system.appearance.other}}</textarea>
  </section>
  <section class="biography">
    <label>Notes</label>
    <textarea name="system.notes" rows="4">{{system.notes}}</textarea>
  </section>
</div>
