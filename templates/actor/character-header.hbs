<div class="foil-part-header">
  {{#if system.destroyed}}<div class="destroyed-banner">Destroyed</div>{{/if}}
  <header class="foil-header char-header">
    <div class="name-row">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Name" class="char-name" />
      <button type="button" class="chargen-btn" data-action="generateCharacter" title="Build a starting character (PHB 2.5.0)"><i class="fas fa-wand-magic-sparkles"></i> Create</button>
      <button type="button" class="chargen-btn" data-action="openAdvancement" title="Spend XP (PHB 2.3.0)"><i class="fas fa-arrow-trend-up"></i> Advance</button>
      <button type="button" class="chargen-btn" data-action="rest" title="1d4 Stress off one Attribute per 2 hours, one ration per 8 hours (PHB 6.10.0)"><i class="fas fa-campground"></i> Rest</button>
    </div>
    <div class="ident-grid">
      <label>Origin</label>
      <span class="readout">{{#if ancestryName}}{{ancestryName}}{{else}}<em class="muted">add an Origin</em>{{/if}}</span>
      <label>Background</label>
      <span class="readout">{{#if backgroundName}}{{backgroundName}}{{else}}<em class="muted">add a Background</em>{{/if}}</span>
      <label>Player</label>
      <input type="text" name="system.player" value="{{system.player}}" />
      <label>Coin (p / s)</label>
      <input type="text" name="system.coin" value="{{system.coin}}" />
      <label>XP Total</label>
      <input type="number" name="system.xp.total" value="{{xp.total}}" />
      <label>XP Spent</label>
      <input type="number" name="system.xp.spent" value="{{xp.spent}}" />
      <label>XP Unspent</label>
      <span class="readout">{{xp.available}}</span>
    </div>
    <div class="tracker-row">
      <div class="tracker token-tracker" title="Earned by invoking a held Habit, once a scene; spent to halve the Stress from one source or to reroll one die (PHB 3.2.0)">
        <label>Foil Tokens</label>
        <a data-action="earnToken" data-delta="-1" title="Remove one"><i class="fas fa-minus"></i></a>
        <span class="readout big">{{tokens.value}} / {{tokens.max}}</span>
        <a data-action="earnToken" data-delta="1" title="Earn one"><i class="fas fa-plus"></i></a>
        <button type="button" class="mini-btn" data-action="absorbStress" title="Spend one to halve the Stress from one source">Halve Stress</button>
      </div>
      <div class="tracker">
        <label title="One per 8 hours of rest or per Travel leg (PHB 6.10.0)">Rations</label>
        <a data-action="adjustRations" data-delta="-1" title="Remove one"><i class="fas fa-minus"></i></a>
        <input type="number" name="system.rations" value="{{system.rations}}" min="0" />
        <a data-action="adjustRations" data-delta="1" title="Add one"><i class="fas fa-plus"></i></a>
      </div>
      <div class="tracker {{#if carry.penalty}}warn{{/if}}" title="The Mass of everything carried, worn Armor included; past 4x Might Potential, every roll takes a penalty (PHB 5.2.6)">
        <label>Mass</label>
        <span class="readout">{{carry.weight}} / {{carry.limit}} lbs</span>
        {{#if carry.penalty}}<span class="state-tag">-{{carry.penalty}} to rolls</span>{{/if}}
      </div>
    </div>
  </header>
</div>
