<div class="foil-body">
  <section class="left-col">
    <table class="attr-table">
      <thead>
        <tr><th class="row-label"></th>{{#each attributes}}<th class="attr-head {{#if this.incapacitated}}incap{{/if}}">{{this.label}}</th>{{/each}}</tr>
      </thead>
      <tbody>
        <tr><th class="row-label">Attribute Dice</th>{{#each attributes}}<td class="dice-cell">{{> systems/foil/templates/actor/partials/dice-pool.hbs}}</td>{{/each}}</tr>
        <tr>
          <th class="row-label" title="Stress taken / the Attribute's Potential (PHB 6.7.0)">Stress / Potential</th>
          {{#each attributes}}
            <td class="stress-cell {{#if this.incapacitated}}incap{{/if}}">
              <input type="number" data-stress="{{this.key}}" value="{{this.stress}}" min="0" /> / {{this.potentialMax}}
              {{#if this.incapacitated}}<span class="state-tag" title="Lifts at {{this.recoverStress}} Stress">Incapacitated</span>{{/if}}
            </td>
          {{/each}}
        </tr>
        <tr>
          <th class="row-label" title="Physical covers Might and Finesse; mental covers Wit and Presence (PHB 6.6.0)">Resistance</th>
          <td colspan="2"><label class="mini">Physical</label>
            <input type="number" name="system.resistance.physical" value="{{resistance.physicalBase}}" />
            {{#if resistance.physicalBonus}}<span class="mod">&rarr; {{resistance.physicalTotal}}</span>{{/if}}</td>
          <td colspan="2"><label class="mini">Mental</label>
            <input type="number" name="system.resistance.mental" value="{{resistance.mentalBase}}" />
            {{#if resistance.mentalBonus}}<span class="mod">&rarr; {{resistance.mentalTotal}}</span>{{/if}}</td>
        </tr>
        <tr>
          <th class="row-label" title="Vulnerable N: -N Resistance against a Broad kind, a Family, a damage type, an Instrument Type, or a Material (PHB 6.6.0, GMG 9.3.0)">Vulnerable</th>
          <td colspan="4">
<div class="vuln-list">
        {{#each vulnRows}}
          <div class="vuln-row">
            <select name="system.vulnerabilities.{{this.idx}}.scope">{{#each this.groups}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}</select>
            {{#if this.isMaterial}}<input type="text" name="system.vulnerabilities.{{this.idx}}.material" value="{{this.material}}" placeholder="silver" />{{/if}}
            <select class="mini-num" name="system.vulnerabilities.{{this.idx}}.n">{{#each this.nChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
            <a data-action="removeVulnerability" data-index="{{this.idx}}" title="Remove"><i class="fas fa-trash"></i></a>
          </div>
        {{/each}}
        <a class="inline-add" data-action="addVulnerability"><i class="fas fa-plus"></i> Add</a>
      </div>
          </td>
        </tr>
      </tbody>
    </table>
    {{> systems/foil/templates/actor/partials/skills-table.hbs}}
  </section>
  <section class="foil-col">
    <h3 class="section-head">FOIL</h3>
    {{#each foil}}
      <div class="axis-habit">
        <div class="axis-habit-head">
          <span class="axis-name">{{this.label}}</span>
          <select name="system.foil.{{this.key}}.lean">
            {{#each this.leanOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <input type="text" name="system.foil.{{this.key}}.habit" value="{{this.habit}}" />
      </div>
    {{/each}}
    {{> systems/foil/templates/actor/partials/conditions.hbs}}
  </section>
</div>
