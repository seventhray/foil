<div class="foil-body">
  <section class="left-col">
    <table class="attr-table">
      <thead>
        <tr><th class="row-label"></th>{{#each attributes}}<th class="attr-head {{#if this.incapacitated}}incap{{/if}}">{{this.label}}</th>{{/each}}</tr>
      </thead>
      <tbody>
        <tr><th class="row-label">Attribute Dice</th>{{#each attributes}}<td class="dice-cell">{{> systems/foil/templates/actor/partials/dice-pool.hbs}}</td>{{/each}}</tr>
        <tr>
          <th class="row-label">Potential</th>
          {{#each attributes}}
            <td class="stress-cell {{#if this.incapacitated}}incap{{/if}}">
              <input type="number" name="system.attributes.{{this.key}}.potential.current" value="{{this.potentialCurrent}}" /> / {{this.potentialMax}}
              {{#if this.incapacitated}}<span class="state-tag" title="Lifts at {{this.recoverAt}}">Incapacitated</span>{{/if}}
            </td>
          {{/each}}
        </tr>
        <tr>
          <th class="row-label" title="Physical covers Might and Finesse; mental covers Wit and Presence (PHB 6.6.0)">Resistance</th>
          <td colspan="2"><label class="mini">Physical</label>
            <input type="number" name="system.resistance.physical" value="{{resistance.physicalBase}}" />
            {{#if resistance.physicalBonus}}<span class="mod">&rarr; {{resistance.physicalTotal}}</span>{{/if}}</td>
          <td colspan="2"><label class="mini">Mental</label>
            <input type="number" name="system.resistance.mental" value="{{resistance.mentalBase}}" />
            {{#if resistance.mentalBonus}}<span class="mod">&rarr; {{resistance.mentalTotal}}</span>{{/if}}</td>
        </tr>
      </tbody>
    </table>
    {{> systems/foil/templates/actor/partials/skills-table.hbs}}
  </section>
  <section class="foil-col">
    <h3 class="section-head">FOIL</h3>
    {{#each foil}}
      <div class="axis-trait">
        <div class="axis-trait-head">
          <span class="axis-name">{{this.label}}</span>
          <select name="system.foil.{{this.key}}.lean">
            {{#each this.leanOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <input type="text" name="system.foil.{{this.key}}.trait" value="{{this.trait}}" />
      </div>
    {{/each}}
    {{> systems/foil/templates/actor/partials/conditions.hbs}}
  </section>
</div>
