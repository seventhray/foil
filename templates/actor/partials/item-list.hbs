<div class="item-table-block">
  <div class="item-list-head">
    <h3 class="section-head">{{heading}}</h3>
    <a class="item-create" data-action="createItem" data-type="{{type}}" title="Add {{heading}}"><i class="fas fa-plus"></i></a>
  </div>
  <table class="item-table {{type}}-table">
    <thead>
      {{#if (foil-eq type "instrument")}}<tr><th class="equip-cell" title="Equipped">&#10003;</th><th>Instrument</th><th>Types</th><th>Primary</th><th>Range</th><th title="Mass carried, in lbs">Mass</th><th>Built-in Techniques</th><th></th></tr>{{/if}}
      {{#if (foil-eq type "technique")}}<tr><th>Technique</th><th>XP</th><th>Source / usable with</th><th>Effect</th><th></th></tr>{{/if}}
      {{#if (foil-eq type "feat")}}<tr><th>Feat</th><th>XP</th><th>Effect</th><th></th></tr>{{/if}}
      {{#if (foil-eq type "equipment")}}<tr><th class="equip-cell" title="Equipped">&#10003;</th><th>Item</th><th>Category</th><th>Effect</th><th title="Mass carried, in lbs">Mass</th><th>Price</th><th></th></tr>{{/if}}
      {{#if (foil-eq type "origin")}}<tr><th>Origin</th><th>Talent</th><th>Feats</th><th></th></tr>{{/if}}
      {{#if (foil-eq type "background")}}<tr><th>Background</th><th>Training</th><th>Know-how</th><th></th></tr>{{/if}}
    </thead>
    <tbody>
      {{#if (foil-eq type "technique")}}
        {{#each builtin}}
          <tr class="item-row builtin-row{{#unless this.ready}} not-ready{{/unless}}" data-item-id="{{this.id}}">
            <td class="item-name">{{this.name}} <span class="abbr">{{this.skillLabel}}</span></td>
            <td class="num">&mdash;</td>
            <td>{{this.source}} <em>(built-in{{#unless this.ready}}, not equipped{{/unless}})</em></td>
            <td class="effect-cell">{{this.effect}}</td>
            <td class="item-actions"><a data-action="rollKit" data-index="{{this.idx}}" class="item-roll" title="Use {{this.name}}"><i class="fas fa-dice-d20"></i></a></td>
          </tr>
        {{/each}}
      {{/if}}
      {{#each list}}
        <tr class="item-row" data-item-id="{{this.id}}">
          {{#if (foil-eq ../type "instrument")}}
            <td class="equip-cell">{{#if this.place}}<input type="checkbox" data-action="toggleEquipped" title="Equipped" {{#if (foil-eq this.place.key "equipped")}}checked{{/if}} />{{/if}}</td>
            <td class="item-name" data-action="editItem">{{this.name}}{{#if this.system.bonus}} +{{this.system.bonus}}{{/if}}{{#if this.system.typeWarning}} <i class="fas fa-triangle-exclamation item-warning" title="{{this.system.typeWarning}}"></i>{{/if}}{{#if this.system.gemSummary}} <i class="fas fa-gem" title="{{this.system.gemSummary}}"></i>{{/if}}</td>
            <td class="quality-cell">{{this.system.typesLabel}}</td>
            <td>{{this.primaryLabel}}</td>
            <td>{{this.system.range}}</td>
            <td class="num" title="{{#if (foil-eq this.place.key "stored")}}Stored: counts for nothing{{else}}Counts toward Mass{{/if}}">{{#if this.system.carriedWeight}}{{this.system.carriedWeight}} lbs{{else}}&mdash;{{/if}}</td>
            <td class="kit-cell">
              {{#each this.kit}}<span class="kit-name" title="{{this.effect}}">{{this.name}} <span class="abbr">{{this.skillLabel}}</span></span>{{/each}}
            </td>
            <td class="item-actions">
              {{#if this.handsWarning}}<i class="fas fa-triangle-exclamation item-warning" title="{{this.handsWarning}}"></i>{{/if}}
              {{#if this.stowable}}<a data-action="cycleLocation" title="{{this.place.label}}: click to {{#if (foil-eq this.place.key "stored")}}carry{{else}}store{{/if}}"><i class="fas {{this.place.icon}}"></i></a>{{/if}}
              {{#if this.system.enchantment.enabled}}<a data-action="rollEnchantment" title="Enchantment: {{this.system.enchantment.effectSummary}}"><i class="fas fa-wand-magic-sparkles"></i></a>{{/if}}
              <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
            </td>
          {{/if}}
          {{#if (foil-eq ../type "technique")}}
            <td class="item-name" data-action="editItem">{{this.name}}{{#if this.system.typeWarning}} <i class="fas fa-triangle-exclamation item-warning" title="{{this.system.typeWarning}}"></i>{{/if}}</td>
            <td class="num">{{this.system.xpCost}}</td>
            <td{{#if this.unusable}} class="warn"{{/if}} title="Requires {{this.system.requiresLabel}}">{{this.usableWith}}</td>
            <td class="effect-cell">{{this.effectDisplay}}</td>
            <td class="item-actions">
              <a data-action="rollTechnique" class="item-roll" title="Use {{this.name}}"><i class="fas fa-dice-d20"></i></a>
              <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
            </td>
          {{/if}}
          {{#if (foil-eq ../type "feat")}}
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td class="num">{{#if this.system.xpCost}}{{this.system.xpCost}}{{else}}&mdash;{{/if}}</td>
            <td class="effect-cell">{{this.system.effect}}</td>
            <td class="item-actions"><a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a></td>
          {{/if}}
          {{#if (foil-eq ../type "equipment")}}
            <td class="equip-cell"><input type="checkbox" data-action="toggleEquipped" title="Equipped" {{#if (foil-eq this.place.key "equipped")}}checked{{/if}} /></td>
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td>{{this.categoryLabel}}</td>
            <td class="effect-cell">{{this.effectSummary}}</td>
            <td class="num" title="{{#if (foil-eq this.place.key "stored")}}Stored: counts for nothing{{else}}Counts toward Mass{{/if}}">{{#if this.system.carriedWeight}}{{this.system.carriedWeight}} lbs{{else}}&mdash;{{/if}}</td>
            <td class="num">{{this.system.price}}p</td>
            <td class="item-actions">
              {{#if this.stowable}}<a data-action="cycleLocation" title="{{this.place.label}}: click to {{#if (foil-eq this.place.key "stored")}}carry{{else}}store{{/if}}"><i class="fas {{this.place.icon}}"></i></a>{{/if}}
              <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
            </td>
          {{/if}}
          {{#if (foil-eq ../type "origin")}}
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td>{{this.system.talentSummary}}</td>
            <td class="effect-cell">{{this.system.featsSummary}}</td>
            <td class="item-actions"><a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a></td>
          {{/if}}
          {{#if (foil-eq ../type "background")}}
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td class="effect-cell">{{this.system.grantsSummary}}</td>
            <td>{{this.system.knowHowSummary}}</td>
            <td class="item-actions"><a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a></td>
          {{/if}}
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
