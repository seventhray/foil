<div class="item-table-block">
  <div class="item-list-head">
    <h3 class="section-head">{{heading}}</h3>
    <a class="item-create" data-action="createItem" data-type="{{type}}" title="Add {{heading}}"><i class="fas fa-plus"></i></a>
  </div>
  <table class="item-table {{type}}-table">
    <thead>
      {{#if (foil-eq type "instrument")}}
        <tr><th>Name</th><th>Weight</th><th>Qualities</th><th>Range</th><th>Stress</th><th>Price</th><th></th></tr>
      {{/if}}
      {{#if (foil-eq type "technique")}}
        <tr><th>Name</th><th>XP</th><th>Requires</th><th>Aptitude</th><th>Target</th><th>Effect</th><th></th></tr>
      {{/if}}
      {{#if (foil-eq type "feat")}}
        <tr><th>Name</th><th>XP</th><th>Effect</th><th></th></tr>
      {{/if}}
      {{#if (foil-eq type "equipment")}}
        <tr><th>Name</th><th>Category</th><th>Effect</th><th>Price</th><th></th></tr>
      {{/if}}
      {{#if (foil-eq type "origin")}}
        <tr><th>Name</th><th>Grants Feat</th><th></th></tr>
      {{/if}}
      {{#if (foil-eq type "background")}}
        <tr><th>Name</th><th>Training</th><th></th></tr>
      {{/if}}
    </thead>
    <tbody>
      {{#each list}}
        <tr class="item-row" data-item-id="{{this.id}}">
          {{#if (foil-eq ../type "instrument")}}
            <td class="item-name" data-action="editItem">{{this.name}}{{#if this.system.typeWarning}} <i class="fas fa-triangle-exclamation item-warning" title="{{this.system.typeWarning}}"></i>{{/if}}{{#if this.enchanted}} <i class="fas fa-wand-magic-sparkles" title="Enchanted: {{this.enchantmentSummary}}"></i>{{/if}}</td>
            <td>{{this.system.weightLabel}}</td>
            <td class="quality-cell">{{this.typeLabelStr}}</td>
            <td>{{this.system.range}}</td>
            <td><a data-action="rollInstrument" class="item-roll" title="Show this Instrument's card">{{this.system.weightLabel}}</a></td>
            <td class="num">{{this.system.price}}p</td>
            <td class="item-actions">
              {{#if this.enchanted}}<a data-action="rollEnchantment" class="item-roll" title="Cast Enchantment: {{this.enchantmentSummary}}"><i class="fas fa-wand-magic-sparkles"></i></a>{{/if}}
              <a data-action="rollInstrument" class="item-roll" title="Roll Stress"><i class="fas fa-dice-d20"></i></a>
              <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
            </td>
          {{/if}}
          {{#if (foil-eq ../type "technique")}}
            <td class="item-name" data-action="editItem">{{this.name}}{{#if this.system.typeWarning}} <i class="fas fa-triangle-exclamation item-warning" title="{{this.system.typeWarning}}"></i>{{/if}}</td>
            <td class="num">{{this.system.xpCost}}</td>
            <td>{{this.requiresLabel}}</td>
            <td title="Rolled to attack">{{this.aptitudeLabel}}</td>
            <td title="Attribute(s) targeted; a defender Opposes with {{this.opposeLabel}}">{{this.targetLabel}}</td>
            <td class="effect-cell">{{this.effectDisplay}}</td>
            <td class="item-actions">
              <a data-action="rollTechnique" class="item-roll" title="Roll {{this.name}}"><i class="fas fa-dice-d20"></i></a>
              <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
            </td>
          {{/if}}
          {{#if (foil-eq ../type "feat")}}
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td class="num">{{this.system.xpCost}}</td>
            <td class="effect-cell">{{#if this.system.effect}}{{this.system.effect}}{{else}}{{this.system.description}}{{/if}}</td>
            <td class="item-actions"><a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a></td>
          {{/if}}
          {{#if (foil-eq ../type "equipment")}}
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td>{{this.categoryLabel}}</td>
            <td class="effect-cell">{{this.effectSummary}}</td>
            <td class="num">{{this.system.price}}p</td>
            <td class="item-actions"><a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a></td>
          {{/if}}
          {{#if (foil-eq ../type "origin")}}
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td>{{this.system.feat}}</td>
            <td class="item-actions"><a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a></td>
          {{/if}}
          {{#if (foil-eq ../type "background")}}
            <td class="item-name" data-action="editItem">{{this.name}}</td>
            <td class="effect-cell">{{this.system.grantsSummary}}</td>
            <td class="item-actions"><a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a></td>
          {{/if}}
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
