<div class="foil-part-header">
  {{#if system.destroyed}}<div class="destroyed-banner">Destroyed</div>{{/if}}

  <header class="foil-header creature-header">
    <div class="name-block">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Name" class="char-name" />
    </div>
    <button type="button" class="chargen-btn" data-action="rest" title="Rest: physical Stress mends 1d6 an hour, mental 1d6 across a night (PHB §6.10.0)">
      <i class="fas fa-campground"></i> Rest
    </button>
    <div class="tier-block">
      <label>Tier</label>
      <input type="text" name="system.tier" value="{{system.tier}}" placeholder="minor" />
      <label>Threat</label>
      <input type="text" name="system.threat" value="{{system.threat}}" />
      <label title="What it does when it Breaks — GMG §4.1.0">Behavior</label>
      <input type="text" name="system.behavior" value="{{system.behavior}}" placeholder="e.g. Territorial [its lair], Craven" />
    </div>
  </header>
</div>
