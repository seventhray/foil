<div class="foil-part-header">
  {{#if system.destroyed}}<div class="destroyed-banner">Destroyed</div>{{/if}}
  <header class="foil-header creature-header">
    <img class="actor-img" src="{{actor.img}}" data-action="editActorImage" title="Change the portrait" width="96" height="96" />
    <div class="name-block">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Name" class="char-name" />
    </div>
    <button type="button" class="chargen-btn" data-action="rest" title="1d4 Stress off one Attribute per 2 hours (PHB 6.10.0)"><i class="fas fa-campground"></i> Rest</button>
    <div class="tier-block">
      <label>Tier</label>
      <input type="number" name="system.tier" value="{{system.tier}}" min="1" />
      <label>CR</label>
      <input type="text" name="system.cr" value="{{system.cr}}" />
      <label title="The four Potentials added together, creature-building shorthand">Total Potential</label>
      <span class="readout">{{health}}</span>
      <label title="What it does once an Attribute is Incapacitated (GMG 9.8.0); blank means it Holds">Behavior</label>
      <input type="text" name="system.behavior" value="{{system.behavior}}" placeholder="e.g. Territorial [its lair]" />
      <label title="Vulnerable N: -N Resistance against a Broad kind, a Family, a damage type, an Instrument Type, or a Material (PHB 6.6.0, GMG 9.3.0)">Vulnerable</label>
      <div class="vuln-list">
        {{#each vulnRows}}
          <div class="vuln-row">
            <select name="system.vulnerabilities.{{this.idx}}.scope">{{#each this.groups}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}</select>
            {{#if this.isMaterial}}<input type="text" name="system.vulnerabilities.{{this.idx}}.material" value="{{this.material}}" placeholder="silver" />{{/if}}
            <select class="mini-num" name="system.vulnerabilities.{{this.idx}}.n">{{#each this.nChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
            <a data-action="removeVulnerability" data-index="{{this.idx}}" title="Remove"><i class="fas fa-trash"></i></a>
          </div>
        {{/each}}
        <a class="inline-add" data-action="addVulnerability"><i class="fas fa-plus"></i> Add</a>
      </div>
    </div>
  </header>
</div>
