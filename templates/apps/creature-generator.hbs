<div class="foil-sheet chargen-body">
  <p class="chargen-intro">Pick a Threat, a CR, or a tier. The numbers follow GMG 9.1.0 to 9.3.0.</p>
  <div class="chargen-grid">
    <fieldset>
      <legend>Name</legend>
      <input type="text" name="name" value="{{state.name}}" placeholder="New Creature" />
    </fieldset>
    <fieldset>
      <legend>Start from</legend>
      <select name="source">{{#each sourceChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      {{#if isTier}}<select name="tier">{{#each tierChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
      {{#if isCr}}<select name="cr">{{#each crChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
      {{#if isThreat}}<input type="number" name="threat" value="{{state.threat}}" step="1" />{{/if}}
    </fieldset>
  </div>
  {{#if isD20}}
    <fieldset>
      <legend>d20 stat block <em>(GMG 11.2.0, 11.5.0, 11.7.0)</em></legend>
      <div class="gen-scores">
        {{#each scoreRows}}<label>{{this.label}} <input type="number" name="score.{{this.key}}" value="{{this.value}}" min="1" max="30" /></label>{{/each}}
        <label>AC <input type="number" name="ac" value="{{state.ac}}" min="0" max="40" /></label>
      </div>
      <p class="hint">{{centerNote}}. AC sets physical Resistance.</p>
    </fieldset>
  {{/if}}

  <fieldset>
    <legend>Assign Attributes <em>(GMG 9.2.0)</em></legend>
    <table class="gen-table">
      <thead><tr><th></th><th>Steps</th><th>Potential</th><th>Dice</th></tr></thead>
      <tbody>
        {{#each rows}}
          <tr><th>{{this.label}}</th>
            <td><select name="step.{{this.key}}" class="mini-num">{{#each this.stepChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></td>
            <td>{{this.potential}}</td><td>{{this.dice}}</td></tr>
        {{/each}}
      </tbody>
      <tfoot><tr><th>Total Potential</th><td></td><td>{{total}}</td><td>tier number {{totalTarget}}</td></tr></tfoot>
    </table>
  </fieldset>

  <div class="chargen-grid">
    <fieldset>
      <legend>Resistance <em>(budget {{budget}}, cap +{{n.resistanceCap}})</em></legend>
      <label>Physical <select name="physical" class="mini-num">{{#each resistanceChoices.physical}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label>Mental <select name="mental" class="mini-num">{{#each resistanceChoices.mental}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <p class="hint">Spends {{spent}} of {{budget}}{{#if refund}} ({{n.resistanceBudget}} plus {{refund}} from Vulnerable){{/if}}.</p>
      {{#each vulnRows}}
        <div class="gen-slot">
          <select name="vuln.{{this.i}}.scope">{{#each this.groups}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}</select>
          <select name="vuln.{{this.i}}.n" class="mini-num">{{#each this.nChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
          <span class="abbr">refunds {{this.refund}}</span>
          <a data-action="removeVuln" data-index="{{this.i}}" title="Remove"><i class="fas fa-trash"></i></a>
        </div>
      {{/each}}
      <a class="inline-add" data-action="addVuln"><i class="fas fa-plus"></i> Add a Vulnerable</a>
    </fieldset>
    <fieldset>
      <legend>Training <em>(+{{n.training}} in the Skills its attacks roll)</em></legend>
      <select name="trainA">{{#each skillA}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      <select name="trainB">{{#each skillB}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    </fieldset>
  </div>

  <fieldset>
    <legend>Behavior Trait <em>(GMG 9.8.0)</em></legend>
    <select name="behavior">{{#each behaviorChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    {{#if behaviorNeedsParam}}<input type="text" name="behaviorParam" value="{{state.behaviorParam}}" placeholder="the bracketed word, such as its lair" />{{/if}}
  </fieldset>

  <fieldset>
    <legend>Instruments <em>(pick 2 or 3, free; GMG 9.6.0)</em></legend>
    {{#each slots}}
      <div class="gen-slot">
        <select name="slot.{{this.i}}.pick"><option value="">None</option>{{#each this.groups}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}</select>
        {{#if this.typeChoices}}<select name="slot.{{this.i}}.type">{{#each this.typeChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
        {{#if this.damageChoices}}<select name="slot.{{this.i}}.damage">{{#each this.damageChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
        {{#if this.primaryChoices}}<select name="slot.{{this.i}}.primary" title="Primary Attribute">{{#each this.primaryChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>Techniques <em>(the built-in ones are free; others cost from the Allowance, GMG 9.7.0)</em></legend>
    <div class="gen-checks">
      {{#each techniques}}
        <label class="{{#if this.over}}warn{{/if}}"><input type="checkbox" name="tech.{{this.name}}" {{#if this.checked}}checked{{/if}} /> {{this.name}} <span class="abbr">{{this.xp}} XP</span></label>
      {{else}}<p class="hint">Pick Instruments to list the Techniques they can carry.</p>{{/each}}
    </div>
  </fieldset>

  <fieldset>
    <legend>Monster Feats <em>(GMG 9.5.1)</em></legend>
    {{#each featRows}}
      <div class="gen-feat {{#if this.over}}warn{{/if}}" title="{{this.effect}}">
        <select name="feat.{{this.name}}" class="mini-num">{{#each this.qtyChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <span>{{this.name}}</span>
        {{#if this.isRes}}<select name="feat.{{this.name}}:scope"><option value="type">Damage type (4 per point)</option><option value="family" {{#if this.familyScope}}selected{{/if}}>Family (8 per point)</option></select>{{/if}}
        <span class="abbr">{{this.xpText}}{{#if this.cost}} &middot; {{this.cost}} XP{{/if}}</span>
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>Traits <em>(GMG 9.5.0)</em></legend>
    <div class="gen-checks">
      {{#each traitRows}}
        <label class="{{#if this.over}}warn{{/if}}"><input type="checkbox" name="trait.{{this.name}}" {{#if this.checked}}checked{{/if}} /> {{this.name}} <span class="abbr">{{this.xp}} XP</span></label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset>
    <legend>Result</legend>
    <p>Threat <strong>{{n.threat}}</strong> &middot; Tier <strong>{{n.tier}}</strong> &middot; Baseline Potential <strong>{{n.potential}}</strong> &middot; Total Potential <strong>{{n.totalPotential}}</strong></p>
    <p>Allowance <strong>{{n.allowance}} XP</strong> (spent {{allowanceSpent}}, left {{allowanceLeft}}) &middot; Ceiling <strong>{{n.ceiling}} XP</strong> &middot; Training <strong>+{{n.training}}</strong></p>
    {{#each warnings}}<p class="type-warning-banner">{{this}}</p>{{/each}}
  </fieldset>

  <footer class="chargen-foot">
    <button type="button" data-action="createCreature"><i class="fas fa-dragon"></i> Create creature</button>
  </footer>
</div>
