<div class="foil-sheet chargen-body">
  <p class="chargen-intro">Pick a Threat, a CR, or a tier. The numbers follow GMG 9.1.0 to 9.3.0.</p>
  <div class="chargen-grid">
    <fieldset>
      <legend data-tooltip="What the creature is called on its sheet.">Name</legend>
      <input type="text" name="name" value="{{state.name}}" placeholder="New Creature" />
    </fieldset>
    <fieldset>
      <legend data-tooltip="Threat is the creature counterpart to XP. Pick a tier, a CR, a d20 stat block, or a Threat number; it sets baseline Potential, Resistance, Training, Allowance, and Ceiling (GMG 9.1.0).">Start from</legend>
      <select name="source">{{#each sourceChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      {{#if isTier}}<select name="tier">{{#each tierChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
      {{#if isCr}}<select name="cr">{{#each crChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
      {{#if isThreat}}<input type="number" name="threat" value="{{state.threat}}" step="1" />{{/if}}
    </fieldset>
  </div>
  {{#if isD20}}
    <fieldset>
      <legend data-tooltip="Enter the converted creature's ability scores and AC. Steps follow how far each Attribute sits from the center of the four; AC sets physical Resistance.">d20 stat block <em>(GMG 11.2.0, 11.5.0, 11.7.0)</em></legend>
      <div class="gen-scores">
        {{#each scoreRows}}<label>{{this.label}} <input type="number" name="score.{{this.key}}" value="{{this.value}}" min="1" max="30" /></label>{{/each}}
        <label>AC <input type="number" name="ac" value="{{state.ac}}" min="0" max="40" /></label>
      </div>
      <p class="hint">{{centerNote}}. AC sets physical Resistance.</p>
    </fieldset>
  {{/if}}

  <fieldset>
    <legend data-tooltip="Move any Attribute up or down in steps of 2 Potential, up to two steps either way. Total Potential stays within one step of the tier's number. Dice are read off the Potential.">Assign Attributes <em>(GMG 9.2.0)</em></legend>
    <table class="gen-table">
      <thead><tr><th></th><th data-tooltip="Steps from the baseline. One step is 2 Potential.">Steps</th><th data-tooltip="The Attribute's Potential: the most its dice can average to.">Potential</th><th data-tooltip="The dice the Attribute rolls at that Potential.">Dice</th></tr></thead>
      <tbody>
        {{#each rows}}
          <tr><th>{{this.label}}</th>
            <td><select name="step.{{this.key}}" class="mini-num">{{#each this.stepChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></td>
            <td>{{this.potential}}</td><td>{{this.dice}}</td></tr>
        {{/each}}
      </tbody>
      <tfoot><tr><th>Total Potential</th><td></td><td>{{total}}</td><td>tier number {{totalTarget}}</td></tr></tfoot>
    </table>
  </fieldset>

  <div class="chargen-grid">
    <fieldset>
      <legend data-tooltip="Resistance subtracts from Stress after margin and Pierce. A budget of 8 per point is split between physical and mental, up to the cap (GMG 9.3.0).">Resistance <em>(budget {{budget}}, cap +{{n.resistanceCap}})</em></legend>
      <label>Physical <select name="physical" class="mini-num">{{#each resistanceChoices.physical}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label>Mental <select name="mental" class="mini-num">{{#each resistanceChoices.mental}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <p class="hint">Spends {{spent}} of {{budget}}{{#if refund}} ({{n.resistanceBudget}} plus {{refund}} from Vulnerable){{/if}}.</p>
      {{#each vulnRows}}
        <div class="gen-slot">
          <select name="vuln.{{this.i}}.scope">{{#each this.groups}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}</select>
          <select name="vuln.{{this.i}}.n" class="mini-num">{{#each this.nChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
          <span class="abbr">refunds {{this.refund}}</span>
          <a data-action="removeVuln" data-index="{{this.i}}" title="Remove"><i class="fas fa-trash"></i></a>
        </div>
      {{/each}}
      <a class="inline-add" data-action="addVuln" data-tooltip="Vulnerable N is -N Resistance against a Broad kind, a Family, a damage type, or an Instrument Type. Each point refunds Resistance budget."><i class="fas fa-plus"></i> Add a Vulnerable</a>
    </fieldset>
    <fieldset>
      <legend data-tooltip="Training is a Skill bonus. Each Skill can have up to the tier's Training. Each +1 costs Allowance XP at the PHB advancement price (8, then 10, 12, and so on).">Training <em>(up to +{{n.training}} a Skill, bought from the Allowance)</em></legend>
      {{#each trainRows}}
        <div class="gen-slot">
          <select name="train.{{this.idx}}.skill">{{#each this.skillChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
          <select class="mini-num" name="train.{{this.idx}}.level">{{#each this.levelChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
          <span class="readout">{{this.cost}} XP</span>
        </div>
      {{/each}}
    </fieldset>
  </div>

  <fieldset>
    <legend data-tooltip="What the creature does once an Attribute is Incapacitated. Traits are checked in order; the first whose condition applies governs. With none, it Holds and fights on (GMG 9.8.0).">Behavior Traits <em>(0 to 3, in order; GMG 9.8.0)</em></legend>
    {{#each behaviorRows}}
      <div class="gen-slot">
        <select name="behavior.{{this.idx}}.trait" data-tooltip="{{this.help}}">{{#each this.choices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        {{#if this.needsParam}}<input type="text" name="behavior.{{this.idx}}.param" value="{{this.param}}" placeholder="the bracketed word, such as its lair" />{{/if}}
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend data-tooltip="The creature's Instruments are free. Natural Weapons and Instruments set which Techniques it can carry and what its attacks look like (GMG 9.6.0).">Instruments <em>(pick 2 or 3, free; GMG 9.6.0)</em></legend>
    {{#each slots}}
      <div class="gen-slot">
        <select name="slot.{{this.i}}.pick"><option value="">None</option>{{#each this.groups}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}</select>
        {{#if this.typeChoices}}<select name="slot.{{this.i}}.type">{{#each this.typeChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
        {{#if this.damageChoices}}<select name="slot.{{this.i}}.damage">{{#each this.damageChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
        {{#if this.primaryChoices}}<select name="slot.{{this.i}}.primary" title="Primary Attribute">{{#each this.primaryChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>{{/if}}
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend data-tooltip="Techniques the creature can use. Built-in ones are free; others cost XP from the Allowance, and none can cost more than the Ceiling (GMG 9.7.0).">Techniques <em>(the built-in ones are free; others cost from the Allowance, GMG 9.7.0)</em></legend>
    <div class="gen-checks">
      {{#each techniques}}
        <label class="{{#if this.over}}warn{{/if}}" data-tooltip="{{this.help}}"><input type="checkbox" name="tech.{{this.name}}" {{#if this.checked}}checked{{/if}} /> {{this.name}} <span class="abbr">{{this.xp}} XP</span></label>
      {{else}}<p class="hint">Pick Instruments to list the Techniques they can carry.</p>{{/each}}
    </div>
  </fieldset>

  <fieldset>
    <legend data-tooltip="Feats made for creatures, bought from the Allowance. Each has a quantity, and none can cost more than the Ceiling (GMG 9.5.1).">Monster Feats <em>(GMG 9.5.1)</em></legend>
    {{#each featRows}}
      <div class="gen-feat {{#if this.over}}warn{{/if}}" data-tooltip="{{this.effect}}">
        <select name="feat.{{this.name}}" class="mini-num">{{#each this.qtyChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
        <span>{{this.name}}</span>
        {{#if this.isRes}}<select name="feat.{{this.name}}:scope"><option value="type">Damage type (4 per point)</option><option value="family" {{#if this.familyScope}}selected{{/if}}>Family (8 per point)</option></select>{{/if}}
        <span class="abbr">{{this.xpText}}{{#if this.cost}} &middot; {{this.cost}} XP{{/if}}</span>
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend data-tooltip="Movement and senses a creature can buy (Fly, Swim, and so on), at the XP shown (GMG 9.5.0).">Traits <em>(GMG 9.5.0)</em></legend>
    <div class="gen-checks">
      {{#each traitRows}}
        <label class="{{#if this.over}}warn{{/if}}" data-tooltip="{{this.help}}"><input type="checkbox" name="trait.{{this.name}}" {{#if this.checked}}checked{{/if}} /> {{this.name}} <span class="abbr">{{this.xp}} XP</span></label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset>
    <legend data-tooltip="Allowance is what the creature can spend on Training, Feats, and Techniques together. Ceiling caps any single one.">Result</legend>
    <p>Threat <strong>{{n.threat}}</strong> &middot; Tier <strong>{{n.tier}}</strong> &middot; Baseline Potential <strong>{{n.potential}}</strong> &middot; Total Potential <strong>{{n.totalPotential}}</strong></p>
    <p>Allowance <strong>{{n.allowance}} XP</strong> (spent {{allowanceSpent}}, left {{allowanceLeft}}) &middot; Ceiling <strong>{{n.ceiling}} XP</strong> &middot; Training <strong>+{{n.training}}</strong></p>
    {{#each warnings}}<p class="type-warning-banner">{{this}}</p>{{/each}}
  </fieldset>

  <footer class="chargen-foot">
    <button type="button" data-action="createCreature"><i class="fas fa-dragon"></i> Create creature</button>
  </footer>
</div>
