<div class="foil-sheet chargen-body advancement-body">
  <p class="chargen-intro">
    Spend <strong>{{actorName}}</strong>'s XP (PHB 2.3.0). Buy one thing at a time; this stays open so a whole
    session's award can be spent in one sitting.
  </p>

  <div class="xp-summary">
    <span>Total <strong>{{xp.total}}</strong></span>
    <span>Spent <strong>{{xp.spent}}</strong></span>
    <span>Available <strong>{{xp.available}}</strong></span>
  </div>

  <fieldset>
    <legend>Attribute Dice</legend>
    {{#each attributeRows}}
      <div class="adv-attr-row">
        <label>{{this.label}} <span class="readout">{{this.diceFormula}}</span></label>
        <div class="adv-btn-row">
          {{#each this.steps}}
            <a class="adv-btn" data-action="advanceDie" data-attr="{{../key}}" data-size="{{this.size}}" data-next="{{this.next}}">
              Talent: {{this.label}} <em>({{this.cost}} XP)</em>
            </a>
          {{/each}}
          {{#if this.knowHowAtLimit}}
            <span class="hint">At the dice limit ({{this.knowHowHeld}} of {{this.knowHowLimit}})</span>
          {{else}}
            <a class="adv-btn" data-action="addDie" data-attr="{{this.key}}">
              Know-how: add 1d4 <em>({{this.newDieCost}} XP, {{this.knowHowHeld}} of {{this.knowHowLimit}} dice)</em>
            </a>
          {{/if}}
        </div>
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>Skill Training <em>(cap: dice in the two pools)</em></legend>
    {{#each skillRows}}
      <div class="adv-attr-row">
        <label>{{this.label}} <span class="readout">+{{this.training}} of +{{this.cap}}</span></label>
        <div class="adv-btn-row">
          {{#if this.capped}}
            <span class="hint">At cap</span>
          {{else}}
            <a class="adv-btn" data-action="train" data-skill="{{this.key}}">+1 Training <em>({{this.cost}} XP)</em></a>
          {{/if}}
        </div>
      </div>
    {{/each}}
  </fieldset>

  <fieldset class="adv-pick-row">
    <legend>Learn a Technique</legend>
    <select>
      {{#each techniques}}
        <option value="{{this.id}}">{{this.name}}: {{this.xp}} XP ({{this.requires}})</option>
      {{/each}}
    </select>
    <a class="adv-btn" data-action="learnTechnique">Learn</a>
  </fieldset>

  <fieldset class="adv-pick-row">
    <legend>Learn a Feat</legend>
    <select>
      {{#each feats}}
        <option value="{{this.id}}" title="{{this.requirements}}">{{this.name}}: {{this.xp}} XP{{#if this.requirements}} (requires {{this.requirements}}){{/if}}</option>
      {{/each}}
    </select>
    <a class="adv-btn" data-action="learnFeat">Learn</a>
  </fieldset>
</div>
