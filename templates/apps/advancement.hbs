<div class="foil-sheet chargen-body advancement-body">
  <p class="chargen-intro">
    Spend <strong>{{actorName}}</strong>'s XP (PHB §4.0.0 XP &amp; Advancement). Buy one thing at a time —
    this stays open so you can spend a whole session's award in one sitting.
  </p>

  <div class="xp-summary">
    <span>Total <strong>{{xp.total}}</strong></span>
    <span>Spent <strong>{{xp.spent}}</strong></span>
    <span>Available <strong>{{xp.available}}</strong></span>
  </div>

  <fieldset>
    <legend>Attribute Dice</legend>
    {{#each attributeRows}}
      <div class="adv-attr-row">
        <label>{{this.label}} <span class="readout">{{this.diceFormula}}</span></label>
        <div class="adv-btn-row">
          {{#each this.steps}}
            <a class="adv-btn" data-action="advanceDie" data-attr="{{../key}}" data-size="{{this.size}}" data-next="{{this.next}}" data-cost="{{this.cost}}">
              {{this.label}} <em>({{this.cost}} XP)</em>
            </a>
          {{/each}}
          <a class="adv-btn" data-action="addDie" data-attr="{{this.key}}">
            Add a new 1d4 <em>({{this.newDieCost}} XP)</em>
          </a>
        </div>
      </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>Aptitude Training</legend>
    {{#each aptitudeRows}}
      <div class="adv-attr-row">
        <label>{{this.label}} <span class="readout">+{{this.training}}</span></label>
        <div class="adv-btn-row">
          <a class="adv-btn" data-action="train" data-apt="{{this.key}}">+1 Training <em>({{this.cost}} XP)</em></a>
        </div>
      </div>
    {{/each}}
  </fieldset>

  <fieldset class="adv-pick-row">
    <legend>Learn a Technique</legend>
    <select>
      {{#each techniques}}
        <option value="{{this.id}}">{{this.name}} — {{this.xp}} XP{{#if this.gate}} (needs Potential {{this.gate}}){{/if}}</option>
      {{/each}}
    </select>
    <a class="adv-btn" data-action="learnTechnique">Learn</a>
  </fieldset>

  <fieldset class="adv-pick-row">
    <legend>Learn a Feat</legend>
    <select>
      {{#each feats}}
        <option value="{{this.id}}" title="{{this.requirements}}">{{this.name}} — {{this.xp}} XP{{#if this.requirements}} (requires {{this.requirements}}){{/if}}</option>
      {{/each}}
    </select>
    <a class="adv-btn" data-action="learnFeat">Learn</a>
  </fieldset>
</div>
