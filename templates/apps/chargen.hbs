<div class="foil-sheet chargen-body">
  <p class="chargen-intro">
    Build <strong>{{actorName}}</strong> (PHB 2.5.0). Every Attribute starts at 2d4; the Ancestry and Background
    add to them. Body and Voice are added automatically. This replaces the character's Attribute dice.
  </p>

  <fieldset>
    <legend>1 · Ancestry <em>(Talent on two dice, two Feats)</em></legend>
    <select name="ancestry">
      <option value="">&mdash;</option>
      {{#each ancestries}}<option value="{{this.name}}" title="{{this.detail}}">{{this.name}}</option>{{/each}}
    </select>
  </fieldset>

  <fieldset>
    <legend>2 · Background <em>(+1 Training ×3, 2d4 Know-how, coin, kit)</em></legend>
    <select name="background">
      <option value="">&mdash;</option>
      {{#each backgrounds}}<option value="{{this.name}}" title="{{this.detail}}">{{this.name}}</option>{{/each}}
    </select>
  </fieldset>

  <fieldset>
    <legend>3 · Starting Point <em>(GMG 2.1.0, one for the whole party)</em></legend>
    <select name="startingPoint">
      <option value="">&mdash; keep current XP &mdash;</option>
      {{#each startingTiers}}<option value="{{this.key}}">{{this.label}}</option>{{/each}}
    </select>
  </fieldset>

  <fieldset>
    <legend>4 · Coin <em>(blank uses the Background's)</em></legend>
    <input type="text" name="coin" placeholder="e.g. 10p" />
  </fieldset>

  <footer class="chargen-foot">
    <button type="submit"><i class="fas fa-wand-magic-sparkles"></i> Build</button>
  </footer>
</div>
